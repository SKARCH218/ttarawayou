# node2(10.8.2.5)의 /opt/trevit/trevit.env 로 복사해 값을 채웁니다.
# systemd 가 EnvironmentFile 로 읽으므로 `export` 를 붙이지 않습니다.

# ── LLM (node1 / 10.8.2.4 의 LM Studio) ──────────────────
# 각 노드는 VPN IP 로만 통신합니다. node1 의 LM Studio 가 0.0.0.0 으로 열려 있어야 합니다.
LMSTUDIO_BASE_URL=http://10.8.2.4:1234/v1
LMSTUDIO_MODEL=google/gemma-4-26b-a4b-qat
LMSTUDIO_ENABLED=true
# 이 시간을 넘기면 휴리스틱으로 폴백합니다. VPN 을 거치므로 로컬보다 넉넉히 줍니다.
LMSTUDIO_TIMEOUT_MS=30000

# ── 외부 API (없어도 수도권 시드 데이터로 동작) ─────────────
TMAP_APP_KEY=
DATA_GO_KR_API_KEY=
ODSAY_API_KEY=

# ── 서버 ─────────────────────────────────────────────────
# 리버스 프록시(집 VPN 서버) 뒤에 있으므로 X-Forwarded-* 를 신뢰합니다.
SERVER_FORWARD_HEADERS_STRATEGY=framework
