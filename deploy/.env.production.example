# node2(10.8.2.5)의 /opt/trevit/trevit.env 로 복사해 값을 채웁니다.
# systemd 가 EnvironmentFile 로 읽으므로 `export` 를 붙이지 않습니다.

# ── LLM (BAZE API Gateway, OpenAI 호환) ──────────────────
# 키는 BAZE 왼쪽 아래 사이드바 "API Gateway"에서 발급합니다. 사용료는 키를 만든 BAZE 계정 크레딧에서 나갑니다.
# node1 의 LM Studio 로 되돌리려면 BASE_URL=http://10.8.2.100:1234/v1, MODEL=google/gemma-4-26b-a4b-qat,
# API_KEY 는 비워 둡니다(LM Studio 의 "Require API key"를 켰다면 그 토큰).
LMSTUDIO_BASE_URL=https://factchat.mindlogic-kr-api.com/v1/gateway
LMSTUDIO_MODEL=gpt-6.1-sol
LMSTUDIO_ENABLED=true
# 이 시간을 넘기면 휴리스틱으로 폴백합니다. 3일 일정은 30초 넘게 걸리므로 넉넉히 줍니다.
LMSTUDIO_TIMEOUT_MS=60000
LMSTUDIO_API_KEY=

# ── DB (node2 로컬 PostgreSQL 18, 백엔드와 같은 서버라 localhost) ──────
# 예전엔 H2 인메모리라 재시작하면 다 날아갔다. 지금은 이 값이 없으면
# 그냥 기동 자체가 안 된다 — 다른 키들처럼 "없으면 폴백"이 아니라 필수값이다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travit
DB_USER=travit
DB_PASSWORD=

# ── 외부 API (없어도 수도권 시드 데이터로 동작) ─────────────
TMAP_APP_KEY=
DATA_GO_KR_API_KEY=
ODSAY_API_KEY=

# ── 서버 ─────────────────────────────────────────────────
# 리버스 프록시(집 VPN 서버) 뒤에 있으므로 X-Forwarded-* 를 신뢰합니다.
SERVER_FORWARD_HEADERS_STRATEGY=framework

# ── 관리자 API (/api/admin/**) ────────────────────────────
# 비어 있으면 /api/admin/** 전체가 503으로 막혀 관리자 기능이 동작하지 않습니다.
# 값을 넣어야만 켜지는 안전한 기본값이므로, 여기 채우지 않으면 그냥 꺼진 채로 남습니다.
ADMIN_TOKEN=
