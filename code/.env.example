# 이 파일을 .env 로 복사하고 발급받은 키를 채워 넣으세요.
# 키가 하나도 없어도 내장 시드 데이터(충남·대전)로 정상 동작합니다.

# SK open API (TMAP) — 전국 실시간 POI·보행/대중교통 경로  https://openapi.sk.com
export TMAP_APP_KEY=""

# 공공데이터포털 — 국토교통부(TAGO) 실시간 버스  https://data.go.kr
export DATA_GO_KR_API_KEY=""

# ODsay 대중교통 API  https://lab.odsay.com
export ODSAY_API_KEY=""

# LM Studio 로컬 AI (OpenAI 호환) — 꺼져 있으면 휴리스틱 알고리즘 폴백
export LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"

# ── 회원가입 인증메일 (SMTP) ─────────────────────────────────────────────
# MAIL_HOST 가 비어 있으면 메일을 보내지 않고 인증코드를 서버 콘솔에 출력합니다(개발·시연용).
# Gmail 을 쓸 경우 MAIL_PASSWORD 는 계정 비밀번호가 아니라 "앱 비밀번호" 16자리입니다.
#   구글 계정 → 보안 → 2단계 인증 켜기 → 앱 비밀번호 생성
export MAIL_HOST=""
export MAIL_PORT="587"
export MAIL_USERNAME=""
export MAIL_PASSWORD=""
export MAIL_FROM="트레빗 <no-reply@trevit.app>"

# ── 구글 로그인 (Google Identity Services) ───────────────────────────────
# Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)
# "승인된 자바스크립트 원본"에 접속 주소를 등록해야 합니다 (예: http://localhost:3000).
# 비어 있으면 로그인 화면에 구글 버튼이 아예 뜨지 않습니다(이메일 로그인은 정상 동작).
export GOOGLE_CLIENT_ID=""
