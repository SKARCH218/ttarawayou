# 따라와유 백엔드 — 외부 API 키 (모두 선택 사항, 없으면 자동 폴백)

# SK open API (TMAP) 앱키 — POI 검색 + 보행자/대중교통 길찾기
# 없거나 쿼터 초과(429) 시 충남·대전 시드 장소 데이터로 자동 폴백
TMAP_APP_KEY=

# ODsay 대중교통 API 키 — TMAP 실패 시 2순위 대중교통 경로
ODSAY_API_KEY=

# 공공데이터포털(data.go.kr) 인증키 — 국토교통부(TAGO) 버스노선/도착/시외버스 정보
DATA_GO_KR_API_KEY=

# LM Studio 로컬 LLM (OpenAI 호환). 꺼져 있으면 휴리스틱 알고리즘으로 자동 폴백
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=google/gemma-4-26b-a4b-qat
LMSTUDIO_ENABLED=true

# 서버 포트 (기본 8080)
PORT=8080
